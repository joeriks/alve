{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alve",
  "version": "0.4.1",
  "identifier": "com.alve.local",
  "build": {
    "frontendDist": "../app/static"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Alve",
        "width": 1100,
        "height": 760,
        "minWidth": 390,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "allowDowngrades": false,
      "endpoints": [
        "https://github.com/joeriks/alve/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExODMzRTFDQUUyOUVGMEIKUldRTDd5bXVIRDZERWNUQ1l5MEdZZWdTdE0wQS90c1NBZFBYYmlzc05GdSthNlJISnZSVlRUa1cK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
